generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/@tilomnov/prisma-client"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  /// One schema per service (migration 34). Each service's database login may
  /// only use its own schema; see docs/DATABASE_SCHEMAS.md.
  schemas  = ["account", "listing", "chat", "payment", "notification"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  deviceId  String?  @map("device_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// The sign-in this token belongs to. Each refresh replaces the token and
  /// copies the fields below to the new row, so the unrevoked row of a session
  /// describes the device; its `createdAt` is when the device was last used.
  sessionId        String?   @map("session_id") @db.Uuid
  sessionStartedAt DateTime? @map("session_started_at") @db.Timestamptz(6)
  deviceName       String?   @map("device_name")
  platform         String?
  ipAddress        String?   @map("ip_address")
  /// Roughly where `ipAddress` is, e.g. "Phnom Penh, Cambodia".
  location         String?

  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([sessionId], map: "idx_refresh_tokens_session_id")
  @@map("refresh_tokens")
  @@schema("account")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone         String?              @unique
  email         String?              @unique
  emailVerified Boolean              @default(false) @map("email_verified")
  phoneVerified Boolean              @default(false) @map("phone_verified")
  passwordHash  String               @map("password_hash")
  /// False while `passwordHash` is a value nobody can match: an account made
  /// by Google sign-in whose owner has not chosen a password yet.
  hasPassword   Boolean              @default(false) @map("has_password")
  role          String               @default("user")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  firebaseUid   String?              @unique @map("firebase_uid")
  avatarUrl     String?              @map("avatar_url")
  /// The unique handle: lowercase letters, digits, "_" and ".". The database
  /// gives every new account one. Null only on a row written by a backend
  /// older than migration 7 that passed an explicit null.
  username      String?              @unique @default(dbgenerated("('user_' || substr(replace(gen_random_uuid()::text, '-', ''), 1, 10))"))
  /// What people see. Not unique.
  name          String?
  firstName     String?              @map("first_name")
  lastName      String?              @map("last_name")
  /// 'male', 'female' or 'other' (checked by the database).
  sex           String?
  /// Set while the owner has switched the account off; signing in clears it.
  deactivatedAt DateTime?            @map("deactivated_at") @db.Timestamptz(6)
  bannedAt DateTime? @map("banned_at") @db.Timestamptz(6)
  payments     PaymentTransaction[]
  subscription Subscription?
  properties    Property[]
  contacts      PropertyContact[]
  favorites     PropertyFavorite[]
  likes         PropertyLike[]
  views         PropertyView[]
  refreshTokens RefreshToken[]

  // E2EE fields
  identityPublicKey String? @map("identity_public_key")
  backupBlob        String? @map("backup_blob")
  backupSalt        String? @map("backup_salt")
  backupNonce       String? @map("backup_nonce")

  /// When the user's last chat connection closed. Null if never connected.
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  keyBackup       ChatKeyBackup?
  searchHistory   SearchHistoryEntry[]
  pushDevices             PushDevice[]
  callsMade               CallLog[] @relation("CallsMade")
  callsReceived           CallLog[] @relation("CallsReceived")
  notificationPreferences NotificationPreferences?
  promotionsSent          Promotion[]
  messagesSent    Message[] @relation("MessagesSent")
  messagesReceived Message[] @relation("MessagesReceived")
  conversationStates      ChatConversationState[] @relation("ConversationStatesOwned")
  conversationStatesAbout ChatConversationState[] @relation("ConversationStatesAbout")
  hiddenMessages          ChatHiddenMessage[]
  following               Follow[] @relation("Following")
  followers               Follow[] @relation("Followers")
  blocking                UserBlock[] @relation("Blocking")
  blockedBy               UserBlock[] @relation("BlockedBy")
  reportsMade             Report[] @relation("ReportsMade")
  reportsAbout            Report[] @relation("ReportsAbout")
  reportsReviewed         Report[] @relation("ReportsReviewed")
  leads                   PropertyLead[]
  savedSearches           SavedSearch[]

  @@index([email], map: "idx_users_email", where: raw("(email IS NOT NULL)"))
  @@index([phone], map: "idx_users_phone", where: raw("(phone IS NOT NULL)"))
  @@index([firebaseUid], map: "idx_users_firebase_uid", where: raw("(firebase_uid IS NOT NULL)"))
  @@map("users")
  @@schema("account")
}

model EmailVerification {
  email String @id
  codeHash String @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("email_verifications")
  @@index([expiresAt])
  @@schema("account")
}

model ModerationAction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  targetId String @map("target_id") @db.Uuid
  action String
  reason String
  status String @default("requested")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([targetId, createdAt], map: "moderation_actions_target_idx")
  @@map("moderation_actions")
  @@schema("account")
}

model Advertisement {
  id String @id @db.Uuid
  imagePath String @unique @map("image_path")
  imageUrl String @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([createdAt], map: "advertisements_created_idx")
  @@map("advertisements")
  @@schema("listing")
}

model Property {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  title            String
  description      String?
  price            Decimal              @db.Decimal(12, 2)
  propertyType     String               @map("property_type")
  status           String               @default("Draft")
  bedrooms         Int?
  bathrooms        Int?
  landSize         Decimal?             @map("land_size") @db.Decimal(10, 2)
  buildingSize     Decimal?             @map("building_size") @db.Decimal(10, 2)
  unitSize         Decimal?             @map("unit_size") @db.Decimal(10, 2)
  totalProjectArea Decimal?             @map("total_project_area") @db.Decimal(10, 2)
  /// 'percent' or 'amount' (USD off `price`); null for no discount.
  discountType     String?              @map("discount_type")
  discountValue    Decimal?             @map("discount_value") @db.Decimal(12, 2)
  /// Sale, Rent, To Let or Takeover Payments (see property-options.ts).
  listingType      String?              @map("listing_type")
  titleType        String?              @map("title_type")
  contactPhone     String?              @map("contact_phone")
  /// Floors of a house or building; total floors of the tower for a condo.
  floors           Int?
  /// The floor a condo unit is on.
  floorNumber      Int?                 @map("floor_number")
  totalUnits       Int?                 @map("total_units")
  hasParking       Boolean?             @map("has_parking")
  hasBalcony       Boolean?             @map("has_balcony")
  furnishing       String?
  buildingType     String?              @map("building_type")
  completionStatus String?              @map("completion_status")
  viewType         String?              @map("view_type")
  maintenanceFee   Decimal?             @map("maintenance_fee") @db.Decimal(12, 2)
  developerName    String?              @map("developer_name")
  projectName      String?              @map("project_name")
  projectType      String?              @map("project_type")
  monthlyRent      Decimal?             @map("monthly_rent") @db.Decimal(12, 2)
  leaseRemainingMonths Int?             @map("lease_remaining_months")
  equipmentIncluded String?             @map("equipment_included")
  reasonForSelling String?              @map("reason_for_selling")
  /// When the markets, hospitals and schools around the listing were last
  /// looked up; null while never looked up (see PropertyNearbyPlace).
  nearbySearchedAt DateTime?            @map("nearby_searched_at") @db.Timestamptz(6)
  lat              Float?
  lng              Float?
  boundaryPoints   Json?                @map("boundary_points")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When it last went live (Draft, Expired or Sold -> Active); null if never. The feed is ordered by it.
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz(6)
  /// When followers were told about it (migration 33): once, the first time it went on the map.
  followersNotifiedAt DateTime? @map("followers_notified_at") @db.Timestamptz(6)
  /// The last time the price a buyer pays fell while it was live, and what it was before.
  priceDroppedAt      DateTime? @map("price_dropped_at") @db.Timestamptz(6)
  previousPrice       Decimal?  @map("previous_price") @db.Decimal(12, 2)
  /// When the people who saved it were last told of a drop (at most once a day).
  priceDropNotifiedAt DateTime? @map("price_drop_notified_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  payments         PaymentTransaction[]
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts         PropertyContact[]
  favorites        PropertyFavorite[]
  images           PropertyImage[]
  reports          Report[]
  leads            PropertyLead[]
  savedSearchMatches SavedSearchMatch[]
  keywords         PropertyKeyword[]
  likes            PropertyLike[]
  nearbyPlaces     PropertyNearbyPlace[]
  views            PropertyView[]
  promotions       Promotion[]
  takeover         PropertyTakeover?

  @@index([userId])
  @@index([status])
  @@index([lat, lng])
  @@index([status, lat, lng])
  @@index([status, propertyType, lat, lng])
  @@index([status, listingType, lat, lng])
  /// The map's newest published listings first (migration 25).
  @@index([createdAt(sort: Desc)], map: "properties_active_newest_idx", where: raw("(status = 'Active'::text)"))
  /// The feed: followed owners' live listings, newest published first (migration 27).
  @@index([userId, publishedAt(sort: Desc), id], map: "properties_active_owner_published_idx", where: raw("(status = 'Active'::text)"))
  @@map("properties")
  @@schema("listing")
}

/// Seller-reported obligations for a takeover listing. The listing price is
/// sellerAmount + remainingBalance; future interest and fees are separate.
model PropertyTakeover {
  propertyId       String   @id @map("property_id") @db.Uuid
  providerType     String?  @map("provider_type")
  providerName     String?  @map("provider_name")
  projectName      String?  @map("project_name")
  sellerAmount     Decimal? @map("seller_amount") @db.Decimal(12, 2)
  remainingBalance Decimal? @map("remaining_balance") @db.Decimal(12, 2)
  balanceAsOf      DateTime? @map("balance_as_of") @db.Date
  paymentAmount    Decimal? @map("payment_amount") @db.Decimal(12, 2)
  paymentFrequency String?  @map("payment_frequency")
  remainingMonths  Int?     @map("remaining_months")
  nextPaymentDate  DateTime? @map("next_payment_date") @db.Date
  interestType     String?  @map("interest_type")
  annualInterestRate Decimal? @map("annual_interest_rate") @db.Decimal(5, 2)
  transferStatus   String?  @map("transfer_status")
  transferFee      Decimal? @map("transfer_fee") @db.Decimal(12, 2)
  transferFeePayer String?  @map("transfer_fee_payer")
  arrearsAmount    Decimal? @map("arrears_amount") @db.Decimal(12, 2)
  arrearsPayer     String?  @map("arrears_payer")
  hasAdditionalPayments Boolean? @map("has_additional_payments")
  notes            String?
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  additionalPayments PropertyTakeoverPayment[]

  @@map("property_takeovers")
  @@schema("listing")
}

/// Larger scheduled payments already included in the remaining balance.
model PropertyTakeoverPayment {
  propertyId String @map("property_id") @db.Uuid
  order      Int
  amount     Decimal? @db.Decimal(12, 2)
  dueDate    DateTime? @map("due_date") @db.Date
  takeover   PropertyTakeover @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)

  @@id([propertyId, order])
  @@map("property_takeover_payments")
  @@schema("listing")
}

/// The features a listing can be tagged with ("road_access", ...). Seeded by
/// migration 14; the codes are what the app sends and translates.
model Keyword {
  code       String            @id
  properties PropertyKeyword[]

  @@map("keywords")
  @@schema("listing")
}

/// The nearest markets, hospitals or schools of a listing tagged near_market,
/// near_hospital or near_school, found by the map provider when the listing
/// was placed. `rank` 0 is the closest by road.
model PropertyNearbyPlace {
  propertyId     String   @map("property_id") @db.Uuid
  category       String
  rank           Int
  name           String
  providerPlaceId String  @map("provider_place_id")
  lat            Float
  lng            Float
  straightMeters Int      @map("straight_meters")
  /// Null when the provider found no road to it.
  roadMeters     Int?     @map("road_meters")
  driveSeconds   Int?     @map("drive_seconds")
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, category, rank])
  @@map("property_nearby_places")
  @@schema("listing")
}

model PropertyKeyword {
  propertyId String   @map("property_id") @db.Uuid
  keyword    String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  keywordRef Keyword  @relation(fields: [keyword], references: [code])

  @@id([propertyId, keyword])
  @@index([keyword, propertyId])
  @@map("property_keywords")
  @@schema("listing")
}

model PropertyImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  url          String
  // A small copy for cards and lists; null until made (see migration 29).
  thumbnailUrl String?  @map("thumbnail_url")
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
  @@schema("listing")
}

model PropertyLike {
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("property_likes")
  @@schema("listing")
}

model PropertyFavorite {
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("property_favorites")
  @@schema("listing")
}

model PropertyView {
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("property_views")
  @@schema("listing")
}

model PropertyContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  name       String
  email      String?
  phone      String?
  message    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@map("property_contacts")
  @@schema("listing")
}

model PaymentTransaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  propertyId String?  @map("property_id") @db.Uuid
  purpose    String   @default("LISTING_PUBLISH")
  subscriptionTier String? @map("subscription_tier")
  requestId  String?  @map("request_id") @db.Uuid
  currency   String   @default("USD")
  paidAt     DateTime? @map("paid_at") @db.Timestamptz(6)
  paymentMethod String? @map("payment_method")
  subscriptionPeriodStart DateTime? @map("subscription_period_start") @db.Timestamptz(6)
  subscriptionPeriodEnd DateTime? @map("subscription_period_end") @db.Timestamptz(6)
  provider   String
  externalId String?  @map("external_id")
  amount     Decimal  @db.Decimal(10, 2)
  status     String   @default("Pending")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?

  @@index([userId])
  @@index([propertyId])
  @@unique([userId, requestId])
  @@map("payment_transactions")
  @@schema("payment")
}

/// The latest purchased period; cancellation stops renewal, never paid access.
model Subscription {
  userId String @id @map("user_id") @db.Uuid
  tier String
  currentPeriodStart DateTime @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd DateTime @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  transactionId String @unique @map("transaction_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@map("subscriptions")
  @@schema("payment")
}

model GuestSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId  String   @unique @map("device_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeen  DateTime @default(now()) @map("last_seen") @db.Timestamptz(6)

  @@map("guest_sessions")
  @@schema("listing")
}

model password_reset_otps {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String
  otp_hash   String
  expires_at DateTime @db.Timestamptz(6)
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([email], map: "idx_password_reset_otps_email")
  @@schema("account")
}

/// A user's chat key, encrypted on their device with a key made from their PIN.
/// The server hands it out only after the PIN is proven, and counts wrong tries.
model ChatKeyBackup {
  userId String @id @map("user_id") @db.Uuid
  /// The device's ciphertext, sealed again with CHAT_BACKUP_SECRET.
  blob   String
  salt   String
  nonce  String
  /// Keyed hash of the PIN proof. Useless without CHAT_BACKUP_SECRET.
  verifier       String
  /// What the device encrypted it with: "pin" (the optional backup PIN) or
  /// "password" (the account password). A new device asks for that one.
  protectedBy    String    @default("pin") @map("protected_by")
  /// Wrong PINs in a row since the last correct one.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_key_backups")
  @@schema("chat")
}

/// One person's own view of a conversation with `partnerId`. A missing row
/// means nothing was archived or deleted.
model ChatConversationState {
  userId     String    @map("user_id") @db.Uuid
  partnerId  String    @map("partner_id") @db.Uuid
  /// Archived while its newest message is no newer than this.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  /// "Delete for me": messages up to this moment are hidden from `userId`.
  clearedAt  DateTime? @map("cleared_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User @relation("ConversationStatesOwned", fields: [userId], references: [id], onDelete: Cascade)
  partner User @relation("ConversationStatesAbout", fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
  @@map("chat_conversation_states")
  @@schema("chat")
}

model Message {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId    String    @map("sender_id") @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  ciphertext  String
  nonce       String
  /// The message this one replies to. Unlinked when that one is deleted.
  replyToId   String?   @map("reply_to_id") @db.Uuid
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// When the sender last changed it; only within an hour of sending.
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)

  sender    User                @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User                @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  replyTo   Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]           @relation("MessageReplies")
  hiddenBy  ChatHiddenMessage[]

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId])
  @@index([replyToId])
  @@map("messages")
  @@schema("chat")
}

/// One message "deleted for me": hidden from `userId` only. The other
/// person still has it.
model ChatHiddenMessage {
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  hiddenAt  DateTime @default(now()) @map("hidden_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
  @@map("chat_hidden_messages")
  @@schema("chat")
}

/// A text the user searched on the home screen. Shown on every device they
/// sign in on, and forgotten after 14 days. Searching the same text again
/// moves its entry to the top instead of adding another.
model SearchHistoryEntry {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// As the user typed it (trimmed), for display.
  query           String
  /// Lowercase, single-spaced: what makes two searches "the same".
  normalizedQuery String   @map("normalized_query")
  searchedAt      DateTime @default(now()) @map("searched_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedQuery])
  @@index([userId, searchedAt(sort: Desc)])
  @@index([searchedAt])
  @@map("search_history")
  @@schema("listing")
}

/// Where to reach one signed-in device with push notifications (Firebase
/// Cloud Messaging). Tied to the session it registered from: signing that
/// device out removes it.
model PushDevice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// The session (`sid` of the access token) that registered it.
  sessionId String?  @map("session_id") @db.Uuid
  /// The Firebase registration token. One device, one row.
  token     String   @unique(map: "push_devices_token_key")
  /// 'android', 'ios' or 'web' (checked by the database).
  platform  String
  /// 'en' or 'km': the language notifications are written in.
  locale    String   @default("en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("push_devices")
  @@schema("notification")
}

/// What a user wants to be told about. No row means the defaults. Security
/// alerts and calls are always sent.
model NotificationPreferences {
  userId       String   @id @map("user_id") @db.Uuid
  chatMessages Boolean  @default(true) @map("chat_messages")
  promotions   Boolean  @default(true)
  /// New listings matching a saved search (migration 32).
  savedSearchAlerts Boolean @default(true) @map("saved_search_alerts")
  /// New listings from people they follow (migration 33).
  followedListings  Boolean @default(true) @map("followed_listings")
  /// Price drops and sales of listings they saved (migration 33).
  savedListingUpdates Boolean @default(true) @map("saved_listing_updates")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
  @@schema("notification")
}

/// A promotion an admin sent to everyone who allows promotions.
model Promotion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy   String?   @map("created_by") @db.Uuid
  title       String
  body        String
  titleKm     String?   @map("title_km")
  bodyKm      String?   @map("body_km")
  /// Opened when the notification is tapped: a listing, or else a web page.
  propertyId  String?   @map("property_id") @db.Uuid
  url         String?
  imageUrl    String?   @map("image_url")
  /// 'queued', 'sending', 'sent' or 'failed' (checked by the database).
  status      String    @default("queued")
  sentCount   Int       @default(0) @map("sent_count")
  failedCount Int       @default(0) @map("failed_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  creator  User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("promotions")
  @@schema("notification")
}

/// One voice call between two people, for tracing it. The audio goes
/// straight between the phones and is never stored.
model CallLog {
  /// Chosen by the caller's app, so a retried invite is the same call.
  id         String    @id @db.Uuid
  callerId   String    @map("caller_id") @db.Uuid
  calleeId   String    @map("callee_id") @db.Uuid
  /// 'ringing', 'active' or 'ended' (checked by the database).
  status     String    @default("ringing")
  /// 'ended', 'declined', 'missed', 'cancelled' or 'disconnected'; null until it ends.
  endReason  String?   @map("end_reason")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  answeredAt DateTime? @map("answered_at") @db.Timestamptz(6)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(6)

  caller User @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@map("call_logs")
  @@schema("chat")
}

/// Who follows whom (migration 26). The pair is the key, so following twice
/// changes nothing; the database refuses following yourself.
model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
  @@schema("account")
}

/// The keys the authentication service signs tokens with (migration 35). It
/// creates, rotates and deletes them itself; other services fetch the public
/// halves from its JWKS endpoint. `privateKeyEncrypted` is AES-256-GCM under
/// JWT_KEY_ENCRYPTION_KEY, and NULL for the imported pre-rotation key.
model JwtSigningKey {
  kid                 String    @id
  publicKey           String    @map("public_key")
  privateKeyEncrypted String?   @map("private_key_encrypted")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activatesAt         DateTime  @map("activates_at") @db.Timestamptz(6)
  retiredAt           DateTime? @map("retired_at") @db.Timestamptz(6)

  @@map("jwt_signing_keys")
  @@schema("account")
}

/// Who has blocked whom (migration 30). Blocking removes follows both ways and
/// stops the two from following, messaging or calling each other.
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
  @@schema("account")
}

/// A report of a listing or an account for an admin to review (migration 30).
/// Exactly one of `propertyId` and `reportedUserId` is set (checked by the
/// database), and a person has at most one open report per target.
model Report {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String    @map("reporter_id") @db.Uuid
  propertyId     String?   @map("property_id") @db.Uuid
  reportedUserId String?   @map("reported_user_id") @db.Uuid
  /// One of `REPORT_REASONS` (checked by the database).
  reason         String
  details        String?
  /// 'open', 'resolved' or 'dismissed'.
  status         String    @default("open")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewNote     String?   @map("review_note")

  reporter     User      @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reportedUser User?     @relation("ReportsAbout", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("ReportsReviewed", fields: [reviewedBy], references: [id])

  @@index([status, createdAt])
  @@map("reports")
  @@schema("account")
}

/// Someone who called or opened a chat about a listing from its page
/// (migration 31): the owner's leads. One row per person, listing and
/// channel ('call' or 'chat', checked by the database).
model PropertyLead {
  propertyId String   @map("property_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  channel    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([propertyId, userId, channel])
  @@index([propertyId, createdAt])
  @@map("property_leads")
  @@schema("listing")
}

/// A map search someone saved (migration 32): an area plus the map filter.
/// Empty lists and null bounds mean any, as in `map-filter.ts`.
model SavedSearch {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String
  minLat       Float    @map("min_lat")
  maxLat       Float    @map("max_lat")
  minLng       Float    @map("min_lng")
  maxLng       Float    @map("max_lng")
  propertyType String?  @map("property_type")
  listingTypes String[] @default([]) @map("listing_types")
  minPrice     Decimal? @map("min_price") @db.Decimal(12, 2)
  maxPrice     Decimal? @map("max_price") @db.Decimal(12, 2)
  minSize      Decimal? @map("min_size") @db.Decimal(12, 2)
  maxSize      Decimal? @map("max_size") @db.Decimal(12, 2)
  keywords     String[] @default([])
  alerts       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches SavedSearchMatch[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_searches")
  @@schema("listing")
}

/// A listing a saved search already alerted about (migration 32).
model SavedSearchMatch {
  savedSearchId String   @map("saved_search_id") @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  savedSearch SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([savedSearchId, propertyId])
  @@map("saved_search_matches")
  @@schema("listing")
}
