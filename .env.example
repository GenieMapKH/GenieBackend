# Copy to .env and fill in. Never commit the real .env.

# --- Ports / service discovery ---
# Each service listens on its own PORT (the defaults below are what docker
# compose uses). Only the api-gateway is meant to be reachable from outside.
#   api-gateway 4000, authentication 4001, user 4002, property 4003, chat 4004, payment 4005
PORT=4000
# Where the gateway finds each service, and where services find each other.
# On Railway use the private network: http://<service>.railway.internal:<PORT>
AUTH_SERVICE_URL=http://localhost:4001
# On the user service: admin system status probes this gateway and the six SERVICE_URLs.
GATEWAY_SERVICE_URL=http://localhost:4000
# Also read by authentication, which calls the user service directly when an
# account is deactivated or deleted.
USER_SERVICE_URL=http://localhost:4002
# Also read by user (cache notices, file erasure) and payment (publishing a listing).
PROPERTY_SERVICE_URL=http://localhost:4003
# property: hours an owner's 2nd, 3rd... newest listing is ranked older in the feed (default 3).
# FEED_OWNER_SPREAD_HOURS=3
# Also read by user (cache notices, file erasure).
CHAT_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
# Cache, rate limits and chat events shared between services and instances.
# Point every service at the SAME Redis (an external one in production).
REDIS_URL=redis://localhost:6379

# --- Security ---
# Browser origins allowed by CORS (comma-separated). Leave empty for mobile-only.
CORS_ORIGINS=
# Gateway only. Leave empty for direct access; behind an ingress, list only
# that ingress's IPs/CIDRs. Never trust client-supplied forwarding headers by hop count.
TRUSTED_PROXIES=
# Token signing keys are created and rotated by the authentication service
# itself (docs/SECRET_ROTATION.md). It stores them encrypted with this key:
# 32 random bytes, base64, authentication only. Generate with:
#   npm run keys:generate
JWT_KEY_ENCRYPTION_KEY=
# Optional: days between key rotations (default 30).
# JWT_KEY_ROTATION_DAYS=30
# Only while switching an environment to rotating keys: the old public key, so
# tokens issued before the switch keep working. Remove it afterwards.
JWT_PUBLIC_KEY=
# Signs the calls services make to each other (HS256, one minute each). The same
# value in user, property, chat and payment; at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_SERVICE_SECRET=
# Shared secret used to sign payment webhooks. Webhooks are rejected without it.
PAYMENT_WEBHOOK_SECRET=
# Mock purchases persist but never charge, including production app builds.
# Temporary default until bank integration; use disabled to stop new purchases; existing paid benefits last until expiry.
APP_ENV=development
PAYMENT_MODE=mock
# Archived backup secret; retained historical rows have no recovery API.
CHAT_BACKUP_SECRET=
# Chat message encryption at rest. Keep stable and back up separately from the database.
CHAT_MESSAGE_SECRET=

# Where "Logged-in devices" looks up the city of an IP address. Empty uses
# https://ipwho.is (free, no key); "off" disables the lookup. Only the address is sent.
IP_LOCATION_API_URL=

# --- Voice calls (chat service) ---
# TURN relay for calls between networks that cannot reach each other directly
# (most calls between two mobile networks). Cloudflare dashboard > Realtime >
# TURN Server > Create: the "Turn Token ID" and its "API Token". Empty: calls
# get public STUN only and often have no audio across networks.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Place search (home screen search bar) ---
# Google Cloud server key with "Places API (New)" enabled; restrict it to that
# API (and to the server's IP if it has a fixed one). Empty: search still finds
# listings and people, but suggests no places.
GOOGLE_PLACES_API_KEY=
# Countries places are searched in, comma-separated ISO codes (default kh).
GOOGLE_PLACES_REGION_CODES=kh

# --- Search engine (property service; optional) ---
# Meilisearch ranks listings and publishers, tolerates typos and splits Khmer
# into words. Empty: search reads the database as before. Use an admin API key,
# not the master key (see docs/RAILWAY.md, "Search engine").
MEILISEARCH_URL=
MEILISEARCH_API_KEY=

# --- Database (Supabase Postgres) ---
# Each service has its own pool: six services x 2 = 12 of 15 session slots.
DATABASE_POOL_MAX=2
DATABASE_POOL_MIN=0
DATABASE_POOL_IDLE_SECONDS=10
# The owner login: migrations, scripts, and any service without its own login.
DATABASE_URL=
DIRECT_URL=
# Each service's own login (migration 34, docs/DATABASE_SCHEMAS.md): it can
# only reach that service's schema. Required by Compose; the admin URL is never passed to containers.
# On Supabase's pooler the user is "<role>.<project ref>", e.g.
# postgresql://chat_service.abcd1234:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
AUTHENTICATION_DATABASE_URL=
USER_DATABASE_URL=
PROPERTY_DATABASE_URL=
CHAT_DATABASE_URL=
PAYMENT_DATABASE_URL=
NOTIFICATION_DATABASE_URL=
# Optional read replica (a paid Supabase plan with a compute add-on). When set,
# only reads that may be a moment old use it: the public map, search, public
# listing pages and publishers' profiles. Empty: everything uses DATABASE_URL.
DATABASE_READ_URL=
# Compose property service only: replica credentials with the property role's permissions.
PROPERTY_DATABASE_READ_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase (Google sign-in). Service account JSON on a single line ---
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Password-reset email: set ONE provider ---
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Error reporting (optional): the Sentry project's DSN. Unset, nothing is sent.
SENTRY_DSN=https://3c0809734a510463333ede94154f00f6@o4512311565484032.ingest.us.sentry.io/4512311620075520
SENTRY_ENVIRONMENT=development
# Optional application log forwarding through the shared Nest logger.
SENTRY_ENABLE_LOGS=false

# Admin Services integrations: set only on the user service (docs/ADMIN_SERVICES.md).
# Use a dedicated Infisical identity restricted to the seven /rotation/*_ROTATED_AT records.
ADMIN_INFISICAL_CLIENT_ID=
ADMIN_INFISICAL_CLIENT_SECRET=
ADMIN_INFISICAL_PROJECT_ID=
ADMIN_INFISICAL_ENVIRONMENT=
# Optional regional/self-hosted base URLs: INFISICAL_API_URL and ADMIN_SENTRY_URL.
ADMIN_SENTRY_TOKEN=
ADMIN_SENTRY_ORGANIZATION=
ADMIN_SENTRY_PROJECT_IDS=
ADMIN_SENTRY_ENVIRONMENT=
# GitHub token: Actions read/write on this backend repository only.
ADMIN_ROTATION_GITHUB_TOKEN=
ADMIN_ROTATION_GITHUB_REPOSITORY=
ADMIN_ROTATION_GITHUB_REF=
# Railway project token scoped to the production environment.
ADMIN_RAILWAY_PROJECT_TOKEN=
ADMIN_RAILWAY_PROJECT_ID=
ADMIN_RAILWAY_ENVIRONMENT_ID=
# JSON mapping of service names to Railway IDs; include only services recovery should control.
ADMIN_RAILWAY_SERVICE_IDS=
